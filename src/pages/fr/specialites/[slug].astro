---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { NavBar, Footer, SpecialtyHero } from '@/components/layout';
import { CTABanner } from '@/components/features';
import { specialties, getSpecialtyBySlug, getRelatedSpecialties } from '@/data/specialties';
import { doctors } from '@/data/doctors';

export async function getStaticPaths() {
  return specialties.map(specialty => ({
    params: { slug: specialty.slug },
    props: { specialty }
  }));
}

const { specialty } = Astro.props;
const related = getRelatedSpecialties(specialty.slug);
const specialtyDoctors = doctors.filter(d => specialty.doctors.includes(d.id));
const specialtyIcons: Record<string, string> = {
  cardiologie: 'heart-pulse',
  neurologie: 'brain',
  oncologie: 'shield-check',
  orthopedie: 'bone',
  pediatrie: 'baby',
  'gynecologie-obstetrique': 'heart-handshake',
  urgences: 'ambulance',
  'check-up': 'clipboard-check',
  'medecine-interne': 'stethoscope',
  'radiologie-imagerie': 'scan-eye',
  'anesthesie-reanimation': 'droplet',
  urologie: 'flask-conical',
  orl: 'ear',
};
const iconName = specialtyIcons[specialty.slug] || 'heart-pulse';
---

<BaseLayout title={`${specialty.name} — Hôpital Saint-Claire`} description={specialty.shortDescription}>
  <NavBar currentLocale="fr" slot="header" />

  <SpecialtyHero
    specialtyName={specialty.name}
    shortDescription={specialty.shortDescription}
    icon={iconName}
    color={specialty.color}
    breadcrumbs={[
      { label: 'Accueil', href: '/fr/' },
      { label: 'Spécialités', href: '/fr/specialites' },
    ]}
  />

  <!-- Main Content -->
  <section className="py-16 lg:py-20 bg-snow">
    <div className="container-main">
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div className="lg:col-span-2 space-y-12">
          <!-- Description -->
          <div>
            <h2 className="font-display font-bold text-heading-lg text-ink mb-4">Présentation du service</h2>
            <p className="text-body leading-relaxed text-ink-muted mb-4">{specialty.fullDescription}</p>
          </div>

          <!-- Pathologies -->
          <div>
            <h2 className="font-display font-bold text-heading-lg text-ink mb-4">Pathologies prises en charge</h2>
            <ul className="grid grid-cols-1 sm:grid-cols-2 gap-3" role="list">
              {specialty.pathologies.map(pathology => (
                <li key={pathology} className="flex items-start gap-2.5 p-3 bg-surface rounded-lg border border-cloud" role="listitem">
                  <svg className="w-5 h-5 flex-shrink-0 mt-0.5 text-heal" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                  </svg>
                  <span className="text-body-sm">{pathology}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Exams -->
          <div>
            <h2 className="font-display font-bold text-heading-lg text-ink mb-4">Examens & Explorations</h2>
            <ul className="grid grid-cols-1 sm:grid-cols-2 gap-3" role="list">
              {specialty.exams.map(exam => (
                <li key={exam} className="flex items-start gap-2.5 p-3 bg-surface rounded-lg border border-cloud" role="listitem">
                  <svg className="w-5 h-5 flex-shrink-0 mt-0.5 text-heal" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span className="text-body-sm">{exam}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Doctors -->
          <div>
            <h2 className="font-display font-bold text-heading-lg text-ink mb-6">Nos Médecins</h2>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4" role="list">
              {specialtyDoctors.map(doctor => (
                <article key={doctor.id} className="bg-surface rounded-xl shadow-card p-5 flex items-start gap-4 transition-all duration-normal hover:shadow-card-hover hover:-translate-y-0.5" role="listitem">
                  <div className="flex-shrink-0 w-16 h-16 rounded-full bg-cloud flex items-center justify-center text-2xl font-display font-bold text-heal" aria-hidden="true">
                    {doctor.lastName.charAt(0)}
                  </div>
                  <div className="flex-1">
                    <h3 className="text-heading-sm font-semibold text-ink mb-1">Dr {doctor.firstName} {doctor.lastName}</h3>
                    <p className="text-body-sm text-ink-muted mb-2">{doctor.specialty}</p>
                    <div className="flex items-center gap-3 text-caption text-ink-muted">
                      <span className="flex items-center gap-1">
                        <svg className="w-3.5 h-3.5 text-heal" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                          <path d="M20 6L9 17l-5-5" />
                        </svg>
                        Disponible conventionné
                      </span>
                    </div>
                  </div>
                  <a
                    href={`/fr/rdv?doctor=${doctor.id}`}
                    className="inline-flex items-center gap-1.5 px-4 py-2 text-caption font-medium text-heal bg-heal-light rounded-lg hover:bg-heal hover:text-snow transition-colors flex-shrink-0"
                  >
                    RDV en ligne
                  </a>
                </article>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside className="lg:col-span-1 space-y-6">
          <!-- Quick Info Card -->
          <div className="bg-surface rounded-xl shadow-card p-6">
            <h3 className="font-display font-semibold text-heading-sm text-ink mb-4">Informations pratiques</h3>
            <div className="space-y-4">
              <div className="flex items-center gap-3">
                <div className="flex-shrink-0 w-10 h-10 rounded-lg bg-heal-light flex items-center justify-center">
                  <svg className="w-5 h-5 text-heal" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                    <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                </div>
                <div>
                  <div className="text-caption text-ink-muted">Consultations</div>
                  <div className="text-body-sm font-medium text-ink">Lun–Sam : 8h–20h</div>
                </div>
              </div>
              <div className="flex items-center gap-3">
                <div className="flex-shrink-0 w-10 h-10 rounded-lg bg-vital-light flex items-center justify-center">
                  <svg className="w-5 h-5 text-vital" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                    <path d="M22 12H2" />
                    <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
                    <line x1="6" y1="16" x2="6.01" y2="16" />
                    <line x1="10" y1="16" x2="10.01" y2="16" />
                  </svg>
                </div>
                <div>
                  <div className="text-caption text-ink-muted">Urgences</div>
                  <div className="text-body-sm font-medium text-ink">24h/24 – 7j/7</div>
                </div>
              </div>
              <div className="flex items-center gap-3">
                <div className="flex-shrink-0 w-10 h-10 rounded-lg bg-gold-light flex items-center justify-center">
                  <svg className="w-5 h-5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                    <path d="M20 10c0-4.4-3.6-8-8-8s-8 3.6-8 8c0 1.8.6 3.5 1.6 4.9-.3 1.5-1.3 3.4-3.1 4.6 2.6 0 4.5-.8 5.7-1.7 1.3.5 2.5.8 3.8.8 4.4 0 8-3.6 8-8z" />
                    <path d="m21 24 4-7h-5" />
                  </svg>
                </div>
                <div>
                  <div className="text-caption text-ink-muted">Prise en charge</div>
                  <div className="text-body-sm font-medium text-ink">Mutuelle & Convention</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Call to Action Card -->
          <div className="bg-ink rounded-xl p-6 text-snow">
            <h3 className="font-display font-semibold text-heading-sm mb-3">Prendre rendez-vous</h3>
            <p className="text-body-sm text-snow/70 mb-4">
              Réservez votre consultation en ligne ou par téléphone
            </p>
            <div className="space-y-3">
              <a
                href={`/fr/rdv?specialty=${specialty.slug}`}
                className="w-full inline-flex items-center justify-center gap-2 px-6 py-3 text-label font-medium text-snow bg-heal rounded-lg hover:bg-heal-hover transition-colors"
              >
                Prendre rendez-vous en ligne
              </a>
              <a
                href="tel:0123456789"
                className="w-full inline-flex items-center justify-center gap-2 px-6 py-3 text-label font-medium text-ink bg-snow rounded-lg hover:bg-cloud transition-colors"
              >
                Appeler le secrétariat
              </a>
            </div>
          </div>

          <!-- Information Card -->
          <div className="bg-surface rounded-xl shadow-card p-6">
            <h3 className="font-display font-semibold text-heading-sm text-ink mb-3">Bon à savoir</h3>
            <p className="text-body-sm text-ink-muted">
              La consultation pré-anesthésique est obligatoire avant toute intervention. Prévoyez vos examens biologiques récents (moins de 6 mois) lors de votre premier rendez-vous.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Related Specialties -->
  <section className="py-16 bg-snow">
    <div className="container-main">
      <h2 className="font-display font-bold text-heading-xl text-ink mb-8">Spécialités connexes</h2>
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
        {related.map(s => (
          <a
            key={s.id}
            href={`/fr/specialites/${s.slug}`}
            className="group bg-surface rounded-xl shadow-card p-6 hover:shadow-card-hover hover:-translate-y-1 transition-all duration-normal"
            role="listitem"
          >
            <div className="w-12 h-12 rounded-xl mb-4 flex items-center justify-center" style={{ backgroundColor: `${s.color}15` }}>
              <svg className="w-6 h-6" style={{ color: s.color }} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
              </svg>
            </div>
            <h3 className="font-semibold text-heading-sm text-ink mb-2 group-hover:text-heal transition-colors">{s.name}</h3>
            <p className="text-body-sm text-ink-muted line-clamp-2">{s.shortDescription}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    title="Une question avant votre consultation ?"
    description="Notre équipe médicale vous informe et vous oriente. Nous vous répondons en moins de 24h ouvrées."
    ctaPrimary={{ label: 'Nous contacter', href: '/fr/contact' }}
    ctaSecondary={{ label: 'Voir tous les médecins', href: '/fr/medecins' }}
    icon="phone"
  />

  <Footer slot="footer" />
</BaseLayout>