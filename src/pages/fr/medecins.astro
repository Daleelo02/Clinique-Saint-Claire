---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { NavBar, Footer } from '@/components/layout';
import { CTABanner } from '@/components/features';
import { doctors, searchDoctors, getDoctorsBySpecialty } from '@/data/doctors';
import { specialties } from '@/data/specialties';
---

<BaseLayout title="Annuaire Médical — Hôpital Saint-Claire" description="Trouvez votre médecin parmi nos 150+ spécialistes. Recherche par nom, spécialité ou pathologie.">
  <NavBar currentLocale="fr" slot="header" />

  <section className="py-12 lg:py-16 bg-snow">
    <div className="container-main">
      <div className="max-w-2xl mx-auto text-center mb-12">
        <h1 className="font-display font-bold text-heading-xl text-ink mb-4">Annuaire Médical</h1>
        <p className="text-body-lg text-ink-muted">
          150+ médecins experts à votre service. Recherchez par nom, spécialité ou consultez toutes les fiches.
        </p>
      </div>

      <!-- Search & Filters -->
      <div className="bg-surface rounded-2xl shadow-card p-6 lg:p-8 mb-8">
        <div className="flex flex-col lg:flex-row gap-6 items-start lg:items-center justify-between mb-6">
          <div className="relative flex-1 max-w-xl">
            <svg className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-ink-muted/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              type="search"
              id="doctor-search"
              placeholder="Rechercher un médecin par nom, spécialité..."
              className="w-full pl-12 pr-4 py-3 text-body bg-snow border border-cloud rounded-lg focus:border-heal focus:ring-2 focus:ring-heal/20 outline-none"
              aria-label="Rechercher un médecin"
            />
          </div>
          <div className="flex items-center gap-4 flex-wrap">
            <select
              id="specialty-filter"
              className="px-4 py-3 text-body bg-snow border border-cloud rounded-lg focus:border-heal focus:ring-2 focus:ring-heal/20 outline-none appearance-none bg-no-repeat bg-right-3 bg-center pr-10"
              aria-label="Filtrer par spécialité"
            >
              <option value="">Toutes les spécialités</option>
              {specialties.map(s => <option key={s.id} value={s.id}>{s.name}</option>)}
            </select>
            <select
              id="availability-filter"
              className="px-4 py-3 text-body bg-snow border border-cloud rounded-lg focus:border-heal focus:ring-2 focus:ring-heal/20 outline-none appearance-none bg-no-repeat bg-right-3 bg-center pr-10"
              aria-label="Filtrer par disponibilité"
            >
              <option value="">Toutes les disponibilités</option>
              <option value="conventionne">Conventionné</option>
              <option value="depassement">Avec dépassement</option>
            </select>
          </div>
        </div>

        <!-- Active filters -->
        <div id="active-filters" className="flex flex-wrap gap-2" aria-live="polite" />
      </div>

      <!-- Results count -->
      <div className="flex items-center justify-between mb-6">
        <p id="results-count" className="text-body-sm text-ink-muted">
          {doctors.length} médecin{s} trouvé{s}
        </p>
      </div>

      <!-- Doctors Grid -->
      <div id="doctors-grid" className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
        {doctors.map((doctor, index) => (
          <article
            key={doctor.id}
            className="bg-surface rounded-xl shadow-card p-6 hover:shadow-card-hover hover:-translate-y-1 transition-all duration-normal"
            role="listitem"
            data-specialty={doctor.specialtyId}
            data-name={`${doctor.firstName} ${doctor.lastName}`.toLowerCase()}
            style={{ animationDelay: `${index * 30}ms` }}
          >
            <div className="flex items-start gap-4 mb-4">
              <div className="flex-shrink-0 w-16 h-16 rounded-full bg-heal-light flex items-center justify-center text-xl font-display font-bold text-heal" aria-hidden="true">
                {doctor.lastName.charAt(0)}
              </div>
              <div className="flex-1 min-w-0">
                <h3 className="font-semibold text-heading-sm text-ink mb-1 truncate">Dr {doctor.firstName} {doctor.lastName}</h3>
                <p className="text-body-sm text-heal font-medium mb-1">{doctor.specialty}</p>
                {doctor.title && <p className="text-caption text-ink-muted">{doctor.title}</p>}
              </div>
            </div>

            <p className="text-body-sm text-ink-muted mb-4 line-clamp-2">{doctor.description}</p>

            <div className="flex flex-wrap gap-2 mb-4">
              {doctor.languages.map(lang => (
                <span key={lang} className="inline-flex items-center px-2 py-1 text-caption bg-cloud text-ink-muted rounded-full">
                  {lang.toUpperCase()}
                </span>
              ))}
            </div>

            <div className="border-t border-cloud pt-4">
              <div className="flex items-center gap-3 text-caption text-ink-muted mb-3">
                <svg className="w-4 h-4 text-heal" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                  <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                <span>{doctor.availability}</span>
              </div>
              <div className="flex items-center gap-2">
                <a href={`/fr/rdv?doctor=${doctor.id}`} className="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2 text-caption font-medium text-heal bg-heal-light rounded-lg hover:bg-heal hover:text-snow transition-colors">
                  Prendre RDV
                </a>
                <a href={`mailto:${doctor.email}`} className="p-2 rounded-lg text-ink-muted hover:text-heal hover:bg-cloud transition-colors" aria-label="Contacter par email">
                  <svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- No results message (hidden by default) -->
      <div id="no-results" className="hidden text-center py-16">
        <svg className="w-16 h-16 mx-auto text-ink-muted/30 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
          <line x1="8" y1="8" x2="16" y2="16" />
        </svg>
        <h3 className="font-display font-semibold text-heading-md text-ink mb-2">Aucun médecin trouvé</h3>
        <p className="text-body text-ink-muted mb-6">Essayez d'élargir votre recherche ou de changer vos filtres.</p>
        <button
          type="button"
          id="clear-filters"
          className="inline-flex items-center gap-2 px-6 py-3 text-label font-medium text-heal bg-heal-light rounded-lg hover:bg-heal hover:text-snow transition-colors"
        >
          Réinitialiser les filtres
        </button>
      </div>
    </div>
  </section>

  <CTABanner
    title="Vous ne trouvez pas votre médecin ?"
    description="Notre secrétariat médical peut vous orienter vers le bon spécialiste selon vos symptômes."
    ctaPrimary={{ label: 'Nous contacter', href: '/fr/contact' }}
    ctaSecondary={{ label: 'Prendre RDV sans médecin précis', href: '/fr/rdv' }}
    icon="phone"
  />

  <Footer slot="footer" />
</BaseLayout>

<script is:inline>
  const searchInput = document.getElementById('doctor-search');
  const specialtyFilter = document.getElementById('specialty-filter');
  const availabilityFilter = document.getElementById('availability-filter');
  const doctorsGrid = document.getElementById('doctors-grid');
  const noResults = document.getElementById('no-results');
  const resultsCount = document.getElementById('results-count');
  const activeFilters = document.getElementById('active-filters');
  const clearFiltersBtn = document.getElementById('clear-filters');

  const doctorCards = Array.from(doctorsGrid.querySelectorAll('[data-specialty]'));

  function filterDoctors() {
    const searchTerm = searchInput.value.toLowerCase().trim();
    const specialtyValue = specialtyFilter.value;
    const availabilityValue = availabilityFilter.value;

    let visibleCount = 0;

    doctorCards.forEach(card => {
      const name = card.dataset.name || '';
      const specialty = card.dataset.specialty || '';
      const availability = card.querySelector('.availability')?.textContent || '';

      const matchesSearch = !searchTerm ||
        name.includes(searchTerm) ||
        specialty.includes(searchTerm) ||
        card.textContent.toLowerCase().includes(searchTerm);

      const matchesSpecialty = !specialtyValue || specialty === specialtyValue;
      const matchesAvailability = !availabilityValue ||
        (availabilityValue === 'conventionne' && !availability.includes('dépassement')) ||
        (availabilityValue === 'depassement' && availability.includes('dépassement'));

      const isVisible = matchesSearch && matchesSpecialty && matchesAvailability;

      card.style.display = isVisible ? 'block' : 'none';
      card.setAttribute('aria-hidden', (!isVisible).toString());

      if (isVisible) visibleCount++;
    });

    // Update results count
    resultsCount.textContent = `${visibleCount} médecin${visibleCount > 1 ? 's' : ''} trouvé${visibleCount > 1 ? 's' : ''}`;

    // Show/hide no results
    noResults.classList.toggle('hidden', visibleCount > 0);
    doctorsGrid.classList.toggle('hidden', visibleCount === 0);

    // Update active filters
    updateActiveFilters();
  }

  function updateActiveFilters() {
    activeFilters.innerHTML = '';
    const filters = [];

    if (searchInput.value.trim()) {
      filters.push({ label: `Recherche : "${searchInput.value.trim()}"`, type: 'search' });
    }
    if (specialtyFilter.value) {
      const opt = specialtyFilter.querySelector(`option[value="${specialtyFilter.value}"]`);
      filters.push({ label: `Spécialité : ${opt?.textContent}`, type: 'specialty' });
    }
    if (availabilityFilter.value) {
      const opt = availabilityFilter.querySelector(`option[value="${availabilityFilter.value}"]`);
      filters.push({ label: `Disponibilité : ${opt?.textContent}`, type: 'availability' });
    }

    filters.forEach(filter => {
      const tag = document.createElement('span');
      tag.className = 'inline-flex items-center gap-1.5 px-3 py-1 text-caption bg-heal-light text-heal rounded-full';
      tag.innerHTML = `
        ${filter.label}
        <button type="button" data-filter="${filter.type}" className="ml-1 p-0.5 rounded hover:bg-heal/20 transition-colors" aria-label="Supprimer ce filtre">
          <svg className="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      `;
      activeFilters.appendChild(tag);
    });
  }

  // Event listeners
  searchInput.addEventListener('input', filterDoctors);
  specialtyFilter.addEventListener('change', filterDoctors);
  availabilityFilter.addEventListener('change', filterDoctors);

  activeFilters.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-filter]');
    if (!btn) return;
    const filterType = btn.dataset.filter;
    if (filterType === 'search') searchInput.value = '';
    else if (filterType === 'specialty') specialtyFilter.value = '';
    else if (filterType === 'availability') availabilityFilter.value = '';
    filterDoctors();
  });

  clearFiltersBtn.addEventListener('click', () => {
    searchInput.value = '';
    specialtyFilter.value = '';
    availabilityFilter.value = '';
    filterDoctors();
  });

  // Initial filter
  filterDoctors();
</script>