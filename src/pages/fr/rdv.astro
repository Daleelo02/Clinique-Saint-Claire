---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { NavBar, Footer } from '@/components/layout';
import { AppointmentForm } from '@/components/features/AppointmentForm';
import { CTABanner } from '@/components/features';
---

<BaseLayout title="Prendre Rendez-vous — Hôpital Saint-Claire" description="Prenez rendez-vous en ligne avec nos médecins spécialistes. Réponse garantie sous 24h.">
  <NavBar currentLocale="fr" slot="header" />

  <section className="py-12 lg:py-16 bg-snow">
    <div className="container-main">
      <div className="max-w-2xl mx-auto text-center mb-12">
        <h1 className="font-display font-bold text-heading-xl text-ink mb-4">Prendre rendez-vous</h1>
        <p className="text-body-lg text-ink-muted">
          Réservez votre consultation en quelques clics. Choisissez votre spécialité, votre médecin et votre créneau horaire.
        </p>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Form -->
        <div className="lg:col-span-2">
          <AppointmentForm
            client:load
            defaultSpecialty={Astro.url.searchParams.get('specialty') || undefined}
            defaultDoctor={Astro.url.searchParams.get('doctor') || undefined}
          />
        </div>

        <!-- Info sidebar -->
        <aside className="lg:col-span-1 space-y-6">
          <div className="bg-surface rounded-xl shadow-card p-6">
            <h3 className="font-display font-semibold text-heading-sm text-ink mb-4 flex items-center gap-2">
              <svg className="w-6 h-6 text-heal" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 6v6l4 2" />
              </svg>
              Horaires des secrétariats
            </h3>
            <ul className="space-y-3 text-body-sm">
              <li className="flex justify-between"><span className="text-ink-muted">Lundi – Vendredi</span><span className="font-medium text-ink">8h – 20h</span></li>
              <li className="flex justify-between"><span className="text-ink-muted">Samedi</span><span className="font-medium text-ink">8h – 13h</span></li>
              <li className="flex justify-between"><span className="text-ink-muted">Dimanche & Jours fériés</span><span className="font-medium text-ink">Fermé</span></li>
            </ul>
          </div>

          <div className="bg-heal-light rounded-xl p-6">
            <h3 className="font-display font-semibold text-heading-sm text-ink mb-3">Besoin d'aide ?</h3>
            <p className="text-body-sm text-ink-muted mb-4">Notre équipe est disponible pour vous orienter.</p>
            <a href="tel:0123456789" className="inline-flex items-center gap-2 text-label font-medium text-heal hover:text-heal-hover transition-colors">
              <svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              01 23 45 67 89
            </a>
          </div>

          <div className="bg-surface rounded-xl shadow-card p-6">
            <h3 className="font-display font-semibold text-heading-sm text-ink mb-4">Documents à prévoir</h3>
            <ul className="space-y-2 text-body-sm text-ink-muted">
              <li className="flex items-center gap-2"><svg className="w-4 h-4 text-heal flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg> Pièce d'identité</li>
              <li className="flex items-center gap-2"><svg className="w-4 h-4 text-heal flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg> Carte Vitale & attestation</li>
              <li className="flex items-center gap-2"><svg className="w-4 h-4 text-heal flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg> Carte de mutuelle</li>
              <li className="flex items-center gap-2"><svg className="w-4 h-4 text-heal flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg> Ordonnances & comptes-rendus</li>
              <li className="flex items-center gap-2"><svg className="w-4 h-4 text-heal flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg> Examens biologiques récents</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTABanner
    title="Une urgence médicale ?"
    description="Notre service d'urgences vous accueille 24h/24, 7j/7 sans rendez-vous."
    ctaPrimary={{ label: 'Accès Urgences', href: '/fr/urgences' }}
    ctaSecondary={{ label: 'Nous appeler', href: 'tel:0123456789' }}
    variant="vital"
    icon="ambulance"
  />

  <Footer slot="footer" />
</BaseLayout>