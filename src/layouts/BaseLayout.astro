---
interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description = "Hôpital Saint-Claire — L'excellence médicale au cœur de vous. Hôpital privé à but non lucratif depuis 1923 — 45 spécialités, 150+ médecins, 98% satisfaction.",
  canonicalURL,
  ogImage = '/og-default.jpg',
  noIndex = false,
} = Astro.props;

const canonical = canonicalURL || Astro.url.origin + Astro.url.pathname;
const locale = Astro.url.pathname.split('/')[1] || 'fr';
const locales = ['fr', 'en', 'ar', 'pt'];
const alternateLinks = locales.map(l => {
  const path = Astro.url.pathname.replace(`/${locale}/`, `/${l}/`).replace(`/${locale}`, `/${l}`);
  return `<link rel="alternate" hreflang="${l}" href="${Astro.url.origin}${path}" />`;
}).join('\n    ');
---

<!DOCTYPE html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Hôpital Saint-Claire</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternateLinks}
    <link rel="alternate" hreflang="x-default" href={Astro.url.origin + '/fr/'} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hôpital Saint-Claire" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.url.origin).href} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : locale === 'en' ? 'en_US' : locale === 'ar' ? 'ar_AR' : 'pt_PT'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@HopitalStClaire" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.url.origin).href} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Fraunces:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Fraunces:wght@500;600;700&display=swap" media="print" onload="this.media='all'" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Hospital",
      "name": "Hôpital Saint-Claire",
      "alternateName": "Hôpital Privé Saint-Claire",
      "description": description,
      "url": Astro.url.origin,
      "logo": new URL('/logo.svg', Astro.url.origin).href,
      "image": new URL(ogImage, Astro.url.origin).href,
      "telephone": "+33123456789",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "45 Avenue de la République",
        "addressLocality": "Saint-Claire",
        "postalCode": "75011",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 48.8566,
        "longitude": 2.3522
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      },
      "medicalSpecialty": [
        "Cardiology", "Neurology", "Oncology", "Orthopedics",
        "Pediatrics", "Gynecology", "Emergency Medicine",
        "Internal Medicine", "Radiology", "Anesthesiology"
      ],
      "sameAs": [
        "https://facebook.com/HopitalSaintClaire",
        "https://twitter.com/HopitalStClaire",
        "https://linkedin.com/company/hopital-saint-claire",
        "https://instagram.com/hopital.saint.claire"
      ],
      "priceRange": "€€€",
      "currenciesAccepted": "EUR",
      "paymentAccepted": "Cash, Credit Card, Insurance",
      "hasMap": "https://goo.gl/maps/example"
    })} />

    <!-- Critical CSS inlined for performance -->
    <style is:inline>
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body { margin: 0; font-family: 'DM Sans', system-ui, sans-serif; line-height: 1.6; color: #0D1B2A; background: #F8FAFC; -webkit-font-smoothing: antialiased; }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      .skip-link { position: absolute; top: -100%; left: 1rem; z-index: 9999; padding: 0.75rem 1.5rem; background: #00A3A1; color: white; font-weight: 500; border-radius: 0.5rem; transition: top 150ms; }
      .skip-link:focus { top: 1rem; }
    </style>
  </head>
  <body class="flex flex-col min-h-screen">
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>
    <slot name="header" />
    <main id="main-content" class="flex-1" role="main">
      <slot />
    </main>
    <slot name="footer" />
    <script is:inline>
      // Language switcher logic
      document.addEventListener('DOMContentLoaded', () => {
        const langButtons = document.querySelectorAll('[data-lang]');
        langButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const lang = btn.getAttribute('data-lang');
            const currentPath = window.location.pathname;
            const newPath = currentPath.replace(/^\/(fr|en|ar|pt)(\/|$)/, `/${lang}/`);
            window.location.href = newPath;
          });
        });
      });
    </script>
  </body>
</html>